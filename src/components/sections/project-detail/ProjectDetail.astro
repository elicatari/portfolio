---
import { render } from 'astro:content';
import Container from '@/components/layout/container/Container.astro';
import Button from '@/components/ui/button/Button.astro';
import Tag from '@/components/ui/tag/Tag.astro';
import Icon from '@/components/ui/icon/Icon.astro';
import ProjectGallery from '@/components/sections/project-gallery/ProjectGallery.astro';
import { useTranslations } from '@/i18n/utils/utils';
import type { Project } from '@/lib/projects/projects';
import type { Lang } from '@/types';
import type { ImageMetadata } from 'astro';

interface Props {
  project: Project;
  lang: Lang;
  /** href de vuelta a la seccion de proyectos de la home. */
  backHref: string;
}

const { project, lang, backHref } = Astro.props;
const t = useTranslations(lang);
const {
  title,
  summary,
  impact,
  cover,
  gallery,
  tags,
  stack,
  role,
  liveUrl,
} = project.data;
const { Content } = await render(project);
const tech = stack?.length ? stack : tags;

const thumbs: ImageMetadata[] = [];
const seen = new Set<string>();
for (const img of [cover, ...(gallery ?? [])]) {
  if (seen.has(img.src)) continue;
  seen.add(img.src);
  thumbs.push(img);
}

---

<article class="py-12 sm:py-16">
  <Container>
    <a
      href={backHref}
      class="text-link text-fluid-sm hover:brightness-110 mb-8 inline-flex items-center gap-2 font-medium transition-colors"
    >
      <Icon name="lucide:arrow-left" size={16} />
      {t.projects.back}
    </a>

    <header class="max-w-3xl">
      <h1 class="text-fluid-xl font-bold tracking-tight">{title}</h1>
      {
        impact && (
          <p class="text-text text-fluid-base mt-3 font-medium leading-snug">{impact}</p>
        )
      }
      <p class="text-muted text-fluid-base mt-3 leading-relaxed">{summary}</p>

      <div class="mt-5 space-y-4">
        {
          role && (
            <div>
              <span class="text-muted text-fluid-sm">{t.projects.role}</span>
              <p class="text-fluid-sm font-medium">{role}</p>
            </div>
          )
        }
        <div>
          <span class="text-muted text-fluid-sm">{t.projects.tech}</span>
          <ul class="mt-1.5 flex flex-wrap gap-1.5">
            {
              tech.map((item) => (
                <li>
                  <Tag>{item}</Tag>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      {
        liveUrl && (
          <div class="mt-6">
            <Button href={liveUrl} target="_blank" rel="noopener noreferrer" size="sm">
              <Icon name="lucide:external-link" size={16} />
              {t.projects.liveDemo}
            </Button>
          </div>
        )
      }
    </header>

    <div class="article-body mt-8 max-w-3xl">
      <Content />
    </div>

    {thumbs.length > 0 && <ProjectGallery images={thumbs} title={title} t={t} />}
  </Container>
</article>