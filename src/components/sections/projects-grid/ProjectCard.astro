---
import { Image } from 'astro:assets';
import Card from '@/components/ui/card/Card.astro';
import Tag from '@/components/ui/tag/Tag.astro';
import Icon from '@/components/ui/icon/Icon.astro';
import type { Project } from '@/lib/projects/projects';
import type { UIDict } from '@/i18n/ui/ui';

interface Props {
  project: Project;
  href: string;
  t: UIDict;
}

const { project, href, t } = Astro.props;
const { title, summary, cover, tags, featured } = project.data;
---

<Card interactive class="group h-full overflow-hidden">
  <a href={href} class="flex h-full flex-col">
    <div class="bg-bg relative aspect-[2.4/1] overflow-hidden">
      <Image
        src={cover}
        alt={title}
        widths={[400, 800]}
        sizes="(min-width: 640px) 50vw, 100vw"
        class="h-full w-full object-cover transition-transform duration-500 ease-[var(--ease-out-soft)] group-hover:scale-105"
      />
    </div>

    <div class="flex flex-1 flex-col p-4">
      <h3 class="text-fluid-base group-hover:text-link font-semibold transition-colors">
        {title}
      </h3>
      {
        featured && (
          <p class="text-accent text-xs mt-1 font-medium">{t.projects.inProduction}</p>
        )
      }
      <p class="text-muted text-fluid-sm mt-1.5 line-clamp-3 flex-1">{summary}</p>

      <ul class="mt-3 flex flex-wrap gap-1.5">
        {
          tags.slice(0, 6).map((tag) => (
            <li>
              <Tag>{tag}</Tag>
            </li>
          ))
        }
      </ul>

      <span class="text-link text-fluid-sm mt-3 inline-flex items-center gap-1.5 font-medium">
        {t.projects.viewProject}
        <Icon
          name="lucide:arrow-right"
          size={14}
          class="transition-transform group-hover:translate-x-1"
        />
      </span>
    </div>
  </a>
</Card>