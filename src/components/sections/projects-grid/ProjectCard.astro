---
import { Image } from 'astro:assets';
import Card from '@/components/ui/card/Card.astro';
import Button from '@/components/ui/button/Button.astro';
import Tag from '@/components/ui/tag/Tag.astro';
import Icon from '@/components/ui/icon/Icon.astro';
import type { Project } from '@/lib/projects/projects';
import type { UIDict } from '@/i18n/ui/ui';

interface Props {
  project: Project;
  href: string;
  t: UIDict;
}

const { project, href, t } = Astro.props;
const {
  title,
  summary,
  impact,
  cover,
  tags,
  inProduction,
  liveUrl,
  frontendRepoUrl,
  backendRepoUrl,
} = project.data;

const hasExternalLinks = Boolean(liveUrl || frontendRepoUrl || backendRepoUrl);
const chipClass = 'relative z-10 h-6 px-2 text-xs gap-1';
---

<Card interactive class="group relative h-full overflow-hidden">
  <div class="flex h-full flex-col">
    <div class="bg-bg relative aspect-[2.4/1] overflow-hidden">
      <Image
        src={cover}
        alt=""
        widths={[400, 800]}
        sizes="(min-width: 640px) 50vw, 100vw"
        class="h-full w-full object-cover transition-transform duration-500 ease-[var(--ease-out-soft)] group-hover:scale-105"
      />
    </div>

    <div class="flex flex-1 flex-col p-4">
      <h3 class="text-fluid-base group-hover:text-link font-semibold transition-colors">
        <a
          href={href}
          class="focus-visible:after:outline-accent after:absolute after:inset-0 focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-2"
        >
          {title}
        </a>
      </h3>
      {
        inProduction && (
          <p class="text-accent text-xs mt-1 font-medium">{t.projects.inProduction}</p>
        )
      }
      {
        impact && (
          <p class="text-text text-fluid-sm mt-1.5 font-medium leading-snug">{impact}</p>
        )
      }
      <p class="text-muted text-fluid-sm mt-1.5 line-clamp-2">{summary}</p>

      {
        hasExternalLinks && (
          <div class="relative z-10 mt-2 flex flex-wrap gap-1.5">
            {liveUrl && (
              <Button
                href={liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                size="xs"
                class={chipClass}
              >
                <Icon name="lucide:external-link" size={12} />
                {t.projects.liveDemo}
              </Button>
            )}
            {frontendRepoUrl && (
              <Button
                href={frontendRepoUrl}
                target="_blank"
                rel="noopener noreferrer"
                variant="outline"
                size="xs"
                class={chipClass}
              >
                <Icon name="simple-icons:github" size={12} />
                {t.projects.codeSampleFrontend}
              </Button>
            )}
            {backendRepoUrl && (
              <Button
                href={backendRepoUrl}
                target="_blank"
                rel="noopener noreferrer"
                variant="outline"
                size="xs"
                class={chipClass}
              >
                <Icon name="simple-icons:github" size={12} />
                {t.projects.codeSampleBackend}
              </Button>
            )}
          </div>
        )
      }

      <ul class="mt-3 flex flex-wrap gap-1.5">
        {
          tags.slice(0, 4).map((tag) => (
            <li>
              <Tag>{tag}</Tag>
            </li>
          ))
        }
      </ul>

      <span class="text-link text-fluid-sm mt-auto pt-3 inline-flex items-center gap-1.5 font-medium">
        {t.projects.viewProject}
        <Icon
          name="lucide:arrow-right"
          size={14}
          class="transition-transform group-hover:translate-x-1"
        />
      </span>
    </div>
  </div>
</Card>