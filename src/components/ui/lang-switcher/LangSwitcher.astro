---
import Icon from '@/components/ui/icon/Icon.astro';
import type { Lang } from '@/types';

interface Props {
  /** URL equivalente en el otro idioma. */
  href: string;
  /** Idioma destino (para hreflang y aria). */
  targetLang: Lang;
  /** Etiqueta del idioma destino (ej. "English"). */
  label: string;
  class?: string;
}

const { href, targetLang, label, class: className } = Astro.props;
---

<a
  href={href}
  hreflang={targetLang}
  lang={targetLang}
  aria-label={label}
  title={label}
  class:list={[
    'text-sm text-muted hover:bg-surface hover:text-text focus-visible:outline-accent inline-flex h-9 items-center gap-1 rounded-md px-2 font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2',
    className,
  ]}
>
  <Icon name="lucide:languages" size={16} />
  <span class="uppercase">{targetLang}</span>
</a>