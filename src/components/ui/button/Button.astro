---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '@/lib/utils/cn/cn';

type Variant = 'primary' | 'outline' | 'ghost';
type Size = 'xs' | 'sm' | 'md' | 'lg';

interface Props extends Omit<HTMLAttributes<'a'>, 'type'> {
  href?: string;
  variant?: Variant;
  size?: Size;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  class: className,
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-md font-medium transition-all duration-200 ease-[var(--ease-out-soft)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:pointer-events-none disabled:opacity-60';

const variants: Record<Variant, string> = {
  primary: 'bg-accent text-accent-fg hover:brightness-110 active:brightness-95 shadow-sm',
  outline: 'border border-border text-text hover:border-accent hover:text-accent',
  ghost: 'text-muted hover:text-text hover:bg-surface',
};

const sizes: Record<Size, string> = {
  xs: 'h-8 px-2.5 text-sm',
  sm: 'h-9 px-3 text-fluid-sm',
  md: 'h-11 px-5 text-fluid-base',
  lg: 'h-13 px-7 text-fluid-lg',
};

const classes = cn(base, variants[variant], sizes[size], className);
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <slot />
    </button>
  )
}