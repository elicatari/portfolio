---
import { cn } from '@/lib/utils/cn/cn';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span
  class={cn(
    'inline-flex items-center gap-2 rounded-full border border-border bg-bg px-3 py-1.5 text-fluid-sm font-medium',
    className,
  )}
>
  <slot />
</span>