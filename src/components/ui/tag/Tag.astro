---
import { cn } from '@/lib/utils/cn/cn';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span
  class={cn(
    'inline-flex items-center rounded-sm bg-accent/10 px-1.5 py-0 text-xs leading-tight font-medium text-accent',
    className,
  )}
>
  <slot />
</span>