---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '@/lib/utils/cn/cn';

interface Props extends HTMLAttributes<'div'> {
  /** Si es true, aplica hover con leve elevacion (para cards enlazadas). */
  interactive?: boolean;
  class?: string;
}

const { interactive = false, class: className, ...rest } = Astro.props;
---

<div
  class={cn(
    'rounded-lg border border-border bg-surface shadow-sm',
    interactive &&
      'transition-all duration-300 ease-[var(--ease-out-soft)] hover:-translate-y-1 hover:shadow-lg hover:border-accent/40',
    className,
  )}
  {...rest}
>
  <slot />
</div>