---
import { site } from '@/data/site/site';
import { personJsonLd } from '@/lib/seo/json-ld/jsonLd';
import type { Lang } from '@/types';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Ruta actual (ej. Astro.url.pathname). */
  path: string;
  /** Ruta equivalente en el otro idioma. */
  alternatePath: string;
  /** Ruta de imagen OG (relativa a /public). */
  ogImage?: string;
  /** true para paginas de detalle (article). */
  article?: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  lang,
  path,
  alternatePath,
  ogImage = site.defaultOgImage,
  article = false,
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(site.url);
const abs = (p: string) => new URL(p, siteUrl).href;

const fullTitle =
  title === site.name ? `${site.nickname} - ${site.name} ${site.projectName}` : `${title} · ${site.name} · ${site.projectName}`;
const canonical = abs(path);
const ogImageUrl = abs(ogImage);

const esUrl = lang === 'es' ? canonical : abs(alternatePath);
const enUrl = lang === 'en' ? canonical : abs(alternatePath);

const jsonLd = personJsonLd(lang);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{noindex && <meta name="robots" content="noindex, nofollow" />}

<link rel="alternate" hreflang="es" href={esUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={esUrl} />

<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={site.name + ' - ' + site.nickname} />
<meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />