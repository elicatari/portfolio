---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/base/BaseLayout.astro';
import ProjectDetail from '@/components/sections/project-detail/ProjectDetail.astro';
import { getProjectsByLang, getProjectSlug, getProjectUrl } from '@/lib/projects/projects';

export const getStaticPaths = (async () => {
  const [esProjects, enProjects] = await Promise.all([
    getProjectsByLang('es'),
    getProjectsByLang('en'),
  ]);
  const enSlugs = new Set(enProjects.map(getProjectSlug));

  return esProjects.map((project) => {
    const slug = getProjectSlug(project);
    return {
      params: { slug },
      props: {
        project,
        alternate: enSlugs.has(slug) ? getProjectUrl('en', slug) : '/en',
      },
    };
  });
}) satisfies GetStaticPaths;

const lang = 'es' as const;
const { project, alternate } = Astro.props;
---

<BaseLayout
  lang={lang}
  title={project.data.title}
  description={project.data.summary}
  alternate={alternate}
  article
>
  <ProjectDetail project={project} lang={lang} backHref="/#proyectos" />
</BaseLayout>